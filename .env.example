# ==============================================================================
# Environment Configuration Template
# Generative AI Practical Course — Dr. Rameshwer
# ==============================================================================
# Copy this file to .env and insert your personal API keys:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit your active .env file or real API keys to GitHub!
# ==============================================================================

# Google Gemini API Key (Required for Google GenAI SDK examples)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model identifier (Recommended: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (For dual-provider experimentation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Microservice Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
